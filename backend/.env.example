# Careerly backend — copy to .env and fill locally. Never commit secrets.
APP_ENV=dev
API_PREFIX=/api/v1
MAX_UPLOAD_BYTES=10485760
AI_PROVIDER=mock
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
CORS_ORIGINS=*
LOG_LEVEL=INFO
ANALYSIS_VERSION=analysis-engine-3.0.0
JOB_MATCH_VERSION=job-match-engine-4.0.0
# mock (default) | production (stub until Apple/Google credentials configured)
SUBSCRIPTION_VERIFIER=mock
# Auth: dev (local/CI; accepts Bearer dev:<user> or X-User-Id) | hmac (production)
AUTH_MODE=dev
# AUTH_TOKEN_SECRET=  # required when APP_ENV=production and AUTH_MODE=hmac

# --- Production checklist (APP_ENV=production will refuse to start otherwise) ---
# APP_ENV=production
# AI_PROVIDER=openai
# OPENAI_API_KEY=...          # EXTERNAL ACTION — never commit
# SUBSCRIPTION_VERIFIER=production
# CORS_ORIGINS=https://app.careerly.ai
# AUTH_MODE=hmac
# AUTH_TOKEN_SECRET=...       # EXTERNAL ACTION — never commit
